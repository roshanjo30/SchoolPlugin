<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <service id="SchoolPlugin\Storefront\Controller\SchoolController" public="true">
            <argument type="service" id="country.repository"/>
            <argument type="service" id="SchoolPlugin\Service\SchoolRegistrationService"/>

            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>


        <service id="SchoolPlugin\Core\Content\School\SchoolDefinition">
            <tag name="shopware.entity.definition" entity="school"/>
        </service>


        <service id="SchoolPlugin\Service\MediaUploadService">
            <argument type="service" id="media.repository"/>
            <argument type="service" id="Shopware\Core\Content\Media\File\FileSaver"/>
        </service>

        <service id="SchoolPlugin\Service\SchoolRegistrationService">
            <argument type="service" id="school.repository"/>
            <argument type="service" id="SchoolPlugin\Service\MediaUploadService"/>
        </service>



        <service id="SchoolPlugin\Service\SchoolCategoryService">
            <argument type="service" id="category.repository"/>
            <argument type="service" id="school.repository"/>
        </service>

       <service id="SchoolPlugin\Controller\SchoolAdminController"
                public="true"
                autowire="false"
                autoconfigure="false">

            <argument type="service" id="school.repository"/>
            <argument type="service" id="sales_channel.repository"/>
            <argument type="service" id="SchoolPlugin\Service\SchoolCategoryService"/>
            <argument type="service" id="event_dispatcher"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="SchoolPlugin\Installer\MailTemplateInstaller">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="SchoolPlugin\Installer\FlowInstaller">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="SchoolPlugin\Event\SchoolApprovedEvent">
            <tag name="shopware.event"/>
        </service>

        <service id="SchoolPlugin\Event\SchoolParentInvitedEvent">
            <tag name="shopware.event"/>
        </service>

        <service id="Shopware\Core\Framework\Event\BusinessEventRegistry">
            <call method="addClasses">
                <argument type="collection">
                    <argument>SchoolPlugin\Event\SchoolApprovedEvent</argument>
                    <argument>SchoolPlugin\Event\SchoolParentInvitedEvent</argument>
                </argument>
            </call>
        </service>


        <service id="SchoolPlugin\Core\Content\SchoolParentInvitation\SchoolParentInvitationDefinition">
            <tag name="shopware.entity.definition"
                entity="school_parent_invitation"/>
        </service>


        <service id="SchoolPlugin\Storefront\Controller\ParentInvitationController"
                public="true">

            <argument type="service" id="school.repository"/>
            <argument type="service" id="school_parent_invitation.repository"/>
            <argument type="service" id="sales_channel.repository"/>

            <argument type="service" id="event_dispatcher"/>

            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>

            <tag name="controller.service_arguments"/>
        </service>

        <service id="SchoolPlugin\Core\Content\SchoolProductPrice\SchoolProductPriceDefinition">
            <tag name="shopware.entity.definition" entity="school_product_price"/>
        </service>
                    

        <service id="SchoolPlugin\Subscriber\SchoolCategoryPageSubscriber">
            <argument type="service" id="school.repository"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="SchoolPlugin\Storefront\Controller\SchoolPageController"
                public="true">

            <argument type="service" id="school.repository"/>

            <argument type="service" id="product.repository"/>

            <argument type="service" id="school_product_price.repository"/>

            <argument type="service"
                id="Shopware\Core\Content\Product\SalesChannel\Detail\ProductDetailRoute"/>

            <argument type="service"
                id="request_stack"/>

            <argument type="service"
                id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>


            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>


            <tag name="controller.service_arguments"/>

        </service>
            



        <service id="SchoolPlugin\Controller\Api\SchoolProductPriceController" public="true">
            <argument type="service" id="school_product_price.repository"/>
            <argument type="service" id="school.repository"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="sales_channel.repository"/>
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\Detail\ProductDetailRoute"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextFactory"/>
            <tag name="controller.service_arguments"/>
        </service>


        <service id="SchoolPlugin\Checkout\SchoolPriceCartProcessor">
            <argument type="service" id="school_product_price.repository"/>
            <argument type="service" id="request_stack"/>

            <tag name="shopware.cart.processor" priority="1000"/>
        </service>

        <service id="SchoolPlugin\Storefront\Controller\SchoolCartController"
                public="true">

            <argument type="service"
                    id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>

            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <argument type="service"
              id="request_stack"/>

            <tag name="controller.service_arguments"/>

        </service>


        <service id="SchoolPlugin\Storefront\Subscriber\SchoolProductDetailSubscriber">

            <argument type="service" id="school_product_price.repository"/>
            <argument type="service" id="request_stack"/>

            <tag name="kernel.event_subscriber"/>

        </service>

        <service id="SchoolPlugin\Storefront\Decorator\SchoolSuggestPageLoaderDecorator"
                decorates="Shopware\Storefront\Page\Suggest\SuggestPageLoader">

            <argument type="service"
                    id="SchoolPlugin\Storefront\Decorator\SchoolSuggestPageLoaderDecorator.inner"/>

            <argument type="service"
                    id="school_product_price.repository"/>

        </service>
            
    </services>
</container>