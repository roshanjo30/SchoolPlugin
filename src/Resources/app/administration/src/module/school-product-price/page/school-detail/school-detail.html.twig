<sw-card title="School Products">

    <sw-data-grid
        v-if="products.length"
        :data-source="products"
        :columns="columns"
    >

        <template #column-name="{ item }">
            {{ item.translated?.name || item.name }}
        </template>

        <template #column-productNumber="{ item }">
            {{ item.productNumber }}
        </template>

        <template #column-defaultPrice="{ item }">
            {{ item.defaultPrice | currency }}
        </template>

        <template #column-schoolPrice="{ item }">
            <sw-number-field
                v-model:value="item.schoolPrice"
                :min="0"
                :step="0.01"
                number-type="float"
            />
        </template>

    </sw-data-grid>

    <sw-empty-state
        v-else
        title="No products found"
    />

    <template #footer>
        <sw-button
            v-if="products.length"
            variant="primary"
            @click="savePrices"
        >
            Save Prices
        </sw-button>
    </template>

</sw-card>