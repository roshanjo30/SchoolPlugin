<sw-page>

    <template #content>

        <sw-data-grid
            v-if="schools.length"
            :data-source="schools"
            :columns="columns"
            :is-loading="isLoading"
            :show-actions="true"

        >  
        <template #column-schoolName="{ item }">
        <a href="#" @click.prevent="onRowClick(item)"> {{ item.schoolName }} </a>
        </template>


        <template #column-status="{ item }">
            <sw-label
                :variant="
                    item.status === 'approved'
                        ? 'success'
                        : item.status === 'disabled'
                            ? 'danger'
                            : 'warning'
                "
            >
                {{ $tc('school.status.' + item.status) }}
            </sw-label>

        </template>

        <template #actions="{ item }">
            <sw-context-menu-item @click="onRowClick(item)">
                Edit
            </sw-context-menu-item>
        </template>

        </sw-data-grid>
        <sw-empty-state
            v-else-if="!isLoading"
            :title="$tc('school.list.emptyTitle')"
            :subline="$tc('school.list.emptyDescription')"
        />
    </template>
</sw-page>