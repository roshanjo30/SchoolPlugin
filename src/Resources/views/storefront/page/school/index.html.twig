{% sw_extends '@Storefront/storefront/base.html.twig' %} 
{% block base_content %}

<div class="container py-5">
{% if violations %}
    {% set nonLogoViolations = violations|filter(v => v.propertyPath != 'logo') %}

    {% if nonLogoViolations|length > 0 %}
        <div class="alert alert-danger">
            <ul>
                {% for violation in nonLogoViolations %}
                    <li>{{ violation.message|trans }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endif %}

    {% if success %}

        <div class="text-center py-5">

            <h1 class="mb-4">
                {{ "schoolPlugin.storefront.registration.successTitle"|trans }}
            </h1>

            <p class="lead">
                {{ "schoolPlugin.storefront.registration.success"|trans }}
            </p>

        </div>

    {% else %}
  
    <h1 class="mb-4">
        {{ "schoolPlugin.storefront.registration.title"|trans }}
    </h1>
   <form method="post"
      enctype="multipart/form-data"
      action="{{ path('frontend.school.registration.submit') }}"
      data-form-validation="true"
      class="school-registration-form"
      novalidate>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label>
                    {{ "schoolPlugin.storefront.registration.schoolName"|trans }} *
                </label>
                <input type="text"
                        class="form-control"
                        name="schoolName"
                        value="{{ formData.schoolName|default('') }}"
                        required
                        data-validation="required">

                    <div class="invalid-feedback">
                        {{ "schoolPlugin.validation.schoolName"|trans }}
                    </div>
            </div>

            <div class="col-md-6 mb-3">
                <label>
                    {{ "schoolPlugin.storefront.registration.contactPerson"|trans }} *
                </label>
                <input type="text"
                        class="form-control"
                        name="contactPerson"
                        value="{{ formData.contactPerson|default('') }}"
                        required
                        data-validation="required">
                    <div class="invalid-feedback">
                        {{ "schoolPlugin.validation.contactPerson"|trans }}
                    </div>
            </div>

            <div class="col-md-6 mb-3">
                <label>
                    {{ "schoolPlugin.storefront.registration.email"|trans }} *
                </label>
                <input type="email"
                        class="form-control"
                        name="email"
                        value="{{ formData.email|default('') }}"
                        required
                        data-validation="email">
                    <div class="invalid-feedback">
                        {{ "schoolPlugin.validation.email"|trans }}
                    </div>
            </div>

            <div class="col-md-6 mb-3">
                <label>
                    {{ "schoolPlugin.storefront.registration.phone"|trans }}
                </label>
                <input type="text"
                       class="form-control"
                       name="phone"
                       value="{{ formData.phone|default('') }}">
            </div>

            <div class="col-md-6 mb-3">
                <label>
                    {{ "schoolPlugin.storefront.registration.street"|trans }}
                </label>
                <input type="text"
                       class="form-control"
                       name="street"
                       value="{{ formData.street|default('') }}">
            </div>

            <div class="col-md-3 mb-3">
                <label>
                    {{ "schoolPlugin.storefront.registration.zipcode"|trans }}
                </label>
                <input type="text"
                       class="form-control"
                       name="zipcode"
                       value="{{ formData.zipcode|default('') }}">
            </div>

            <div class="col-md-3 mb-3">
                <label>
                    {{ "schoolPlugin.storefront.registration.city"|trans }}
                </label>
                <input type="text"
                       class="form-control"
                       name="city"
                       value="{{ formData.city|default('') }}">
            </div>

            <div class="col-md-6 mb-3">

            <label for="countryId">
                {{ "schoolPlugin.storefront.registration.country"|trans }} *
            </label>

            <select class="form-select"
                    id="countryId"
                    name="countryId"
                    required="required"
                    data-validation="required">

                <option value="">
                    {{ "schoolPlugin.storefront.registration.selectCountry"|trans }}
                </option>

                {% for country in countries %}
                    <option
                        value="{{ country.id }}"
                        {% if formData.countryId|default('') == country.id %}
                            selected
                        {% endif %}>
                        {{ country.translated.name }}
                    </option>
                {% endfor %}

            </select>

            <div class="invalid-feedback">
                {{ "schoolPlugin.validation.country"|trans }}
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <label for="logo">
                {{ "schoolPlugin.storefront.registration.logo"|trans }} *
            </label>

            {% set logoViolation = null %}

            {% for violation in violations|default([]) %}
                {% if violation.propertyPath == 'logo' %}
                    {% set logoViolation = violation %}
                {% endif %}
            {% endfor %}

            <input
                type="file"
                id="logo"
                name="logo"
                accept=".jpg,.jpeg,.png,.svg"
                required="required"
                data-validation="required"
                class="form-control{% if logoViolation or error|default(false) %} is-invalid{% endif %}">

            {% if logoViolation %}
                <div class="invalid-feedback d-block">
                    {{ logoViolation.message|trans }}
                </div>

            {% elseif error|default(false) %}
                <div class="invalid-feedback d-block">
                    {{ error }}
                </div>

            {% else %}
                <div class="invalid-feedback">
                    {{ "schoolPlugin.validation.logo"|trans }}
                </div>
            {% endif %}
        </div>
                
            <div class="col-12 mb-3">
                <label>
                    {{ "schoolPlugin.storefront.registration.comments"|trans }}
                </label>

                <textarea class="form-control"
                          rows="5"
                          name="comment">{{ formData.comment|default('') }}</textarea>
            </div>
        </div>

        <button class="btn btn-primary">
            {{ "schoolPlugin.storefront.registration.submit"|trans }}
        </button>
    </form>
    {% endif %}
</div>
{% endblock %} 